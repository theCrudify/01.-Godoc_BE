# ─── Server Configuration ─────────────────────────────────────────
NODE_ENV=development
PORT=7777
CORS_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# ─── Database Configuration (MySQL - Dual Schema) ─────────────────
# Schema 1: User Management (prisma/schema1.prisma)
DATABASE_URL_1="mysql://username:password@localhost:3306/godoc_users"
# Schema 2: Document Management (prisma/schema2.prisma)
DATABASE_URL_2="mysql://username:password@localhost:3306/godoc_documents"

# ─── JWT Authentication ───────────────────────────────────────────
JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRATION="24h"
JWT_EXPIRES_IN="24h"

# ─── Email / SMTP Configuration (Nodemailer) ──────────────────────
SMTP_HOST="mail.aio.co.id"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="appsskb@aio.co.id"
SMTP_PASS="your_smtp_password"
SMTP_FROM='"Go-Document System" <appsskb@aio.co.id>'

